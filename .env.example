# Andrii-IT NIS2 Audit Platform — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git!

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# Admin login
ADMIN_EMAIL=admin@andrii-it.de
ADMIN_PASSWORD=CHANGE_ME_use_strong_password_min_16_chars

# Anthropic API key for AI audit agent — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here...
# Modell für den Haupt-Loop (Tool-Auswahl, Findings schreiben). Sonnet als Standard —
# im Test lieferte Haiku deutlich mehr Findings (Duplikate, teils ohne Pflicht-Präfix
# "[Compliance-Hinweis]"). Bei $100/Audit ist die Ersparnis durch Haiku marginal;
# auf claude-haiku-4-5 umstellen, wenn Kosten wichtiger sind als Berichtsqualität.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Modell NUR für den finalen Verifikations-/Qualitäts-Check (critical/high Findings)
ANTHROPIC_MODEL_VERIFY=claude-sonnet-4-5
# Kosten pro Mio. Token (USD) für die Kosten-Schätzung im Audit-Log — bei Preisänderung anpassen
ANTHROPIC_COST_HAIKU_IN=1.0
ANTHROPIC_COST_HAIKU_OUT=5.0
ANTHROPIC_COST_SONNET_IN=3.0
ANTHROPIC_COST_SONNET_OUT=15.0

# Database path (inside Docker volume)
DB_PATH=/data/nis2audit.db

# Kassensystem-Check (passiv: Shodan-Index + CVE-Abgleich, KEINE aktive Verbindung zur Kasse)
# Shodan API Key — https://account.shodan.io/ (Einmalzahlung ca. $49-Plan reicht)
SHODAN_API_KEY=CHANGE_ME_your_shodan_key_here
# NVD API Key — optional, erhöht Rate-Limit — https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=CHANGE_ME_your_nvd_key_here

# E-Mail-Versand (Angebot/Bericht) über Gmail SMTP mit App-Passwort
# App-Passwort erzeugen (erfordert 2FA am Google-Konto):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine-adresse@gmail.com
SMTP_APP_PASSWORD=CHANGE_ME_16_stelliges_app_passwort_ohne_leerzeichen
SMTP_FROM_NAME=Andrii-IT

# Öffentliche Basis-URL dieser Anwendung (für Bestätigungs-/Zahlungslinks in E-Mails)
PUBLIC_BASE_URL=https://deine-domain.de

# Stripe Checkout (Kunde bestätigt Angebot + bezahlt über personalisierten Link)
# https://dashboard.stripe.com/apikeys  /  https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=CHANGE_ME_sk_live_oder_sk_test
STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec_...
